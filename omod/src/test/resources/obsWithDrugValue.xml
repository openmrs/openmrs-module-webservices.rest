<!--
    An observation answered with a drug, which no dataset in core or this module had.

    Obs.getValueAsString takes its CWE branch only when the question concept's datatype is Coded and
    value_coded is set, and within that branch prefers value_drug over the coded answer's name. So
    all three columns are needed for the drug to be what the display prints:

      concept_id="21"  FOOD ASSISTANCE FOR ENTIRE FAMILY, datatype Coded
      value_coded="22" UNKNOWN, the answer the drug stands in for
      value_drug="2"   Triomune-30, whose concept is 792 STAVUDINE LAMIVUDINE AND NEVIRAPINE

    Drug.getFullName renders "Triomune-30 (STAVUDINE LAMIVUDINE AND NEVIRAPINE)", so this fixture
    covers a rule refusing the drug and a rule refusing the concept behind it.
-->
<dataset>
	<obs obs_id="5200" person_id="7" concept_id="21" value_coded="22" value_drug="2" status="FINAL"
		 obs_datetime="2008-08-01 00:00:00.0" creator="1" date_created="2008-08-18 14:09:05.0" voided="false"
		 uuid="8d0f5b2e-1c4a-4f3d-9a7b-6e2c0d15f840"/>
</dataset>
